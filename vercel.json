{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug(ux-ui|social-media-ads|social-media-motion)",
      "destination": "/work/:slug/index.html"
    },
    {
      "source": "/:page(services|contact)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/projects/:slug(aurum|schenker|unispace)",
      "destination": "/projects/:slug/index.html"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
